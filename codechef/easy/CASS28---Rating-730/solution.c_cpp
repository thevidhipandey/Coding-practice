#include <stdio.h>

int main() {
    int a, b, c;
    scanf("%d %d %d", &a, &b, &c);
    if(a>0 && a<=100 && b>0 && b<=100 & c>0 && c<=100)
    {
    if(a==b==c)
    printf("Equilateral");
    else if(a==b || b==c || a==c)
    printf("Isosceles");
    else
    printf("Scalene");
    }

    return 0;
}
