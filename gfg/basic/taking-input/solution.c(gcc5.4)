#include <math.h>
#include <stdio.h>

int main() {
    char s[1000];
    int n;
    float f;
    int ff; // To Store floor of float variable f

    // code here
    scanf(" %[^\n]", s);
    scanf("%d", &n);
    scanf("%f", &f);
    ff = floor(f);

    printf("%s\n", s);
    printf("%d\n", n);
    printf("%d\n", ff);

    return 0;
}